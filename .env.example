# Confluence installation URL, including its context path when present:
# e.g. https://wiki.company.local/confluence or https://company.atlassian.net/wiki
CONFLUENCE_BASE_URL=https://wiki.example.com/confluence

# Server/Data Center: login and password. Cloud: email and API token if Basic Auth is supported.
CONFLUENCE_USERNAME=your-login
CONFLUENCE_PASSWORD=your-password

# Optional settings
CONFLUENCE_TIMEOUT_SECONDS=30
CONFLUENCE_MAX_PAGE_BYTES=5000000
# Minimum interval between HTTP requests, in milliseconds. 1000 = at most 1 RPS.
# Shared by all tools in one server process; 0 disables throttling.
CONFLUENCE_REQUEST_INTERVAL_MS=1000
# Logs are written automatically to logs/confluence-mcp-<PID>.log, beside server.py.
# Values: DEBUG, INFO, WARNING, ERROR; INFO is the default.
CONFLUENCE_LOG_LEVEL=INFO
# Path to corporate CA PEM certificate bundle. Leave blank for normal system CA trust.
CONFLUENCE_CA_BUNDLE=

